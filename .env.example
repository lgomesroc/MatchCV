
# Ambiente local: nunca use estas credenciais de exemplo em produção.

APP_ENVIRONMENT=development

DATABASE_HOST=localhost
DATABASE_PORT=1433
DATABASE_NAME=MatchCV
DATABASE_USER=sa
DATABASE_PASSWORD=ChangeThisPassword123!

# Link público do Angular usado nos e-mails de recuperação (sem barra final).
PASSWORD_RESET_FRONTEND_URL=http://localhost:4200

# SMTP obrigatório para envio de instruções. Use credenciais de app, nunca senha pessoal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MatchCV
SMTP_TIMEOUT_SECONDS=10

# Provedor de IA primário
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_PRIMARY_BASE_URL=
AI_PRIMARY_TIMEOUT_SECONDS=60

# Provedor de IA secundário (fallback)
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_TIMEOUT_SECONDS=60

# Gere uma chave Fernet válida e compartilhe o mesmo valor entre API e worker.
ANALYSIS_QUEUE_ENCRYPTION_KEY=

# Defina true somente se a API também for executar o worker.
RUN_ANALYSIS_WORKER=false

# Separe múltiplas origens por vírgula.
FRONTEND_ORIGIN=http://localhost:4200

# Opcional: protege Swagger/ReDoc; se ausentes, a documentação fica indisponível.
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Necessário apenas para inicialização administrativa controlada.
MATCHCV_ADMIN_BOOTSTRAP_TOKEN=
